# Copy to .env for local development. On Render, set these as environment variables.
DATABASE_URL=postgres://clinilog:CHANGE_ME@localhost:5432/clinilog

# Render sets PORT automatically; 8080 is the local default.
PORT=8080

# At least 32 random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime in minutes (default 480 = 8 hours, one clinic shift).
JWT_TTL_MINUTES=480

RUST_LOG=clinilog_server=debug,tower_http=info

# Used only by `cargo run --bin seed`. Min 8 chars, with a letter and a number.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
